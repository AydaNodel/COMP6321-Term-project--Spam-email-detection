    ax1.plot(metrics_cb.train_steps, metrics_cb.train_losses, label="Train Loss", color='tab:blue')
    if metrics_cb.eval_losses:
        ax1.plot(metrics_cb.eval_steps, metrics_cb.eval_losses, label="Val Loss", color='tab:orange', marker='o')
    ax1.set_xlabel("Steps")
